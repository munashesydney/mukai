{
  "name": "mukai",
  "version": "0.1.0",
  "description": "Mukai \u2014 a workspace for ideas that move forward.",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "out/main/index.js",
  "author": "Mukai",
  "license": "UNLICENSED",
  "scripts": {
    "build:guest": "tsx scripts/build-guest.ts",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "dev:server": "tsx watch src/server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "tsx scripts/run-browser-smoke.ts",
    "test:capabilities": "tsx scripts/run-capability-smoke.ts",
    "test:memory-embeddings": "tsx scripts/memory-embedding-check.ts",
    "test:memory-ui": "tsx scripts/run-memory-smoke.ts",
    "build": "npm run typecheck && electron-vite build && tsc -p tsconfig.server.json",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "electron-vite preview",
    "start:server": "node dist/server/src/server/index.js",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:skills-ui": "tsx scripts/run-skills-smoke.ts",
    "test:bots-ui": "tsx scripts/run-bot-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@fontsource/inter": "^5.2.6",
    "@huggingface/transformers": "4.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ai": "^7.0.127",
    "ajv": "^8.20.0",
    "diff": "9.0.0",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.mukai.desktop",
    "productName": "Mukai",
    "icon": "src/renderer/public/mukai-logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@esbuild/**/*",
      "node_modules/onnxruntime*/**/*",
      "node_modules/@huggingface/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
