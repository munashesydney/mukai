{
  "name": "mukai",
  "version": "0.1.0",
  "description": "Mukai — a workspace for ideas that move forward.",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "out/main/index.js",
  "author": "Mukai",
  "license": "UNLICENSED",
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "build:cli": "npm run build:computer-use && npm run build:guest && npm run build:web && tsx scripts/cli/build.ts",
    "package:cli": "tsx scripts/cli/package.ts",
    "test:cli:packaged": "tsx scripts/cli/smoke.ts",
    "test:cli:browser": "tsx scripts/cli/browser-smoke.ts",
    "test:cli:updates": "npm run build:web && tsx scripts/cli/update-smoke.ts",
    "test:settings-ui": "tsx scripts/run-shared-settings-smoke.ts",
    "test:shared-backend": "npm run build:web && electron-vite build && tsx scripts/shared-backend-smoke.ts",
    "test:providers-ui": "node --import tsx scripts/provider-settings-smoke.ts",
    "test:reasoning-ui": "node --import tsx scripts/reasoning-smoke.ts",
    "test:media-ui": "node --import tsx scripts/media-attachments-smoke.ts",
    "test:cli:installer": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/cli/install-smoke.ps1",
    "build:guest": "tsx scripts/build-guest.ts",
    "build:computer-use": "tsx scripts/build-computer-use.ts",
    "test:computer-use": "tsx scripts/run-computer-use-smoke.ts",
    "test:computer-use:windows-search": "tsx scripts/run-computer-use-windows-search-smoke.ts",
    "test:computer-use:vm": "tsx scripts/run-computer-use-vm-smoke.ts",
    "test:clipboard:vm": "npm run build:guest && tsx scripts/run-clipboard-vm-smoke.ts",
    "predev": "npm run build:computer-use && npm run build:guest && npm run build:web",
    "predev:server": "npm run build:computer-use && npm run build:guest",
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "dev:server": "tsx watch src/server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "tsx scripts/run-browser-smoke.ts",
    "test:browser-profiles": "tsx scripts/run-browser-smoke.ts --profiles-only",
    "test:vm-health": "tsx scripts/test-vm-health.ts",
    "test:capabilities": "tsx scripts/run-capability-smoke.ts",
    "test:capabilities:vm": "tsx scripts/run-capability-vm-smoke.ts",
    "test:memory-embeddings": "tsx scripts/memory-embedding-check.ts",
    "test:memory-ui": "tsx scripts/run-memory-smoke.ts",
    "test:chat-activity-ui": "tsx scripts/run-chat-activity-smoke.ts",
    "test:delegation-ui": "node --import tsx scripts/delegation-ui-smoke.ts",
    "test:response-activity-ui": "node --import tsx scripts/response-activity-smoke.ts",
    "test:terminal-ui": "npm run build:web && tsx scripts/terminal-smoke.ts",
    "test:steering-ui": "tsx scripts/steering-smoke.ts",
    "build": "npm run typecheck && npm run build:computer-use && npm run build:guest && npm run build:web && electron-vite build && tsc -p tsconfig.server.json",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "electron-vite preview",
    "start:server": "node dist/server/src/server/index.js",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:packaged": "tsx scripts/run-packaged-smoke.ts",
    "test:release": "tsx --test scripts/release.test.ts scripts/cli/release.test.ts scripts/cli/install.test.ts scripts/notarize-macos.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:skills-ui": "tsx scripts/run-skills-smoke.ts",
    "test:bots-ui": "tsx scripts/run-bot-smoke.ts",
    "test:telegram-ui": "tsx scripts/run-telegram-smoke.ts",
    "test:workspace-ui": "tsx scripts/run-bot-smoke.ts --workspace-only"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@fontsource/inter": "^5.2.6",
    "@huggingface/transformers": "4.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@novnc/novnc": "^1.7.0",
    "ai": "^7.0.127",
    "ajv": "^8.20.0",
    "diff": "9.0.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.13.0",
    "mdast-util-from-markdown": "^2.1.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/notarize": "2.5.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/novnc__novnc": "^1.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "onnxruntime-node": "1.23.2"
  },
  "build": {
    "appId": "com.mukai.desktop",
    "productName": "Mukai",
    "publish": {
      "provider": "github",
      "owner": "munashesydney",
      "repo": "mukai",
      "channel": "latest",
      "releaseType": "release"
    },
    "detectUpdateChannel": false,
    "electronUpdaterCompatibility": ">=2.16",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "src/renderer/public/mukai-logo.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "dist/web",
        "to": "web"
      },
      {
        "from": "dist/guest",
        "to": "guest"
      },
      {
        "from": "dist/computer_use",
        "to": "computer_use",
        "filter": [
          "windows.ps1",
          "linux.py",
          "linux_wayland.py",
          "macos"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@esbuild/**/*",
      "node_modules/onnxruntime*/**/*",
      "node_modules/@huggingface/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/detect-libc/**/*",
      "node_modules/semver/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "binaries": [
        "Contents/Resources/computer_use/macos"
      ],
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Mukai captures the desktop when you use the computer_use screenshot action."
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
